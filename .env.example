# Copy to .env and fill in. Generate a token with:  openssl rand -base64 24
SWITCHYARD_TOKEN=change-me-to-a-long-random-string

# Host port (compose binds it to 127.0.0.1)
SWITCHYARD_PORT=8787

# Public URL of this server (used as the tap target of phone pushes), e.g. https://switchyard.example.com
PUBLIC_URL=

# Phone pushes via ntfy (https://ntfy.sh or self-hosted): full topic URL. Pick a long, unguessable
# topic name on ntfy.sh — anyone who knows it can read the messages.
NTFY_URL=
NTFY_TOKEN=

# Usage alert thresholds in % for the 5-hour and 7-day windows (empty disables)
SWITCHYARD_ALERTS=80,95

# Scan Claude Code transcripts in the container (needs the volume mounts in docker-compose.yml)
# SWITCHYARD_SCAN_HOME=/home/you
