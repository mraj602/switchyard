# Merged mode: the hub as a systemd user service on your own computer.
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/systemd/switchyard-hub.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now switchyard-hub.service
#   loginctl enable-linger "$USER"        # optional: keep it running when logged out
#
# Edit ExecStart if `sy` is not in ~/.local/bin. It listens on 127.0.0.1 only.
[Unit]
Description=Switchyard hub (merged mode)
Documentation=https://github.com/mraj602/switchyard
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/sy hub serve --listen 127.0.0.1:8787
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
# Light hardening (the hub writes under ~/.local/share, ~/.local/state and ~/.config).
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
