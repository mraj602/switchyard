[Unit]
Description=Switchyard hub (merged mode)
Documentation=https://github.com/mraj602/switchyard
After=network.target

[Service]
Type=simple
Environment="SY_STATE_DIR=/data/sy state"
ExecStart=/home/alice/.local/bin/sy hub serve --listen 127.0.0.1:8787
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
