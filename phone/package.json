{
  "name": "switchyard-phone",
  "version": "1.0.0",
  "description": "Switchyard phone app (Expo): the hub's screens, native pushes with Open, Snooze and Seen, and widgets. Unofficial; not affiliated with Anthropic.",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --ci",
    "check-secrets": "node scripts/check-no-secrets.mjs",
    "prebuild-check": "node scripts/prebuild-check.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check-secrets"
  },
  "dependencies": {
    "@expo/ui": "58.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.16",
    "expo-build-properties": "58.0.11",
    "expo-clipboard": "58.0.3",
    "expo-constants": "58.0.12",
    "expo-dev-client": "58.0.14",
    "expo-device": "58.0.5",
    "expo-linking": "58.0.13",
    "expo-router": "58.0.24",
    "expo-secure-store": "58.0.2",
    "expo-widgets": "58.0.21",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-android-widget": "0.22.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "babel-preset-expo": "57.0.13",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
