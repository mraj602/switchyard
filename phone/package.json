{
  "name": "switchyard-phone",
  "version": "1.0.0",
  "description": "Switchyard phone app (Expo): the hub's screens, native pushes with Open, Snooze and Seen, and widgets. Unofficial; not affiliated with Anthropic.",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --ci",
    "check-secrets": "node scripts/check-no-secrets.mjs",
    "prebuild-check": "node scripts/prebuild-check.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check-secrets"
  },
  "dependencies": {
    "@expo/ui": "57.0.21",
    "@react-native-async-storage/async-storage": "3.1.1",
    "expo": "57.0.26",
    "expo-build-properties": "57.0.22",
    "expo-clipboard": "57.0.2",
    "expo-constants": "57.0.20",
    "expo-dev-client": "57.0.19",
    "expo-device": "57.0.2",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-widgets": "57.0.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-android-widget": "0.23.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "babel-preset-expo": "58.0.18",
    "eslint": "10.13.0",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.11",
    "test-renderer": "1.3.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
