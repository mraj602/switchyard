   "note": "switchyard <version> (sy-local)",
   "op": "write_tree",
   "path": "$HOME/.local/state/switchyard/plugin/marketplace",
   "pre": [
    {
     "path": "$HOME/.local/state/switchyard/plugin/marketplace",
     "state": {
      "type": "absent"
     }
    }
   ],
   "step": "plugin"
  },
  {
   "argv": [
    "claude",
    "plugin",
    "marketplace",
    "add",
    "$HOME/.local/state/switchyard/plugin/marketplace",
