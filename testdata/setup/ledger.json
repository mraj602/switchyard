{
  "v": 1,
  "plugin": {"marketplace": "/home/u/.local/state/switchyard/plugin/marketplace", "id": "switchyard@sy-local",
             "roots": ["/home/u/.claude/plugins"], "targets": ["/home/u/.claude/settings.json"]},
  "statusline": {"/home/u/.claude/settings.json": {"original": "bash /home/u/.claude/statusline-command.sh"}},
  "env_keys": ["/home/u/.claude/settings.json"],
  "launchers": [{"path": "/home/u/.local/bin/claude-8", "sha256": "dddd"}],
  "mcp_sync": ["/home/u/.claude.json"],
  "hub_service": {"name": "switchyard-hub", "unit": "/home/u/.config/systemd/user/switchyard-hub.service"},
  "timer": true,
  "prototype_removed": [{"file": "/home/u/.claude/settings.json", "event": "Stop",
                         "entry": {"hooks": [{"type": "command", "command": "bash ~/.claude/switchyard-hook.sh # switchyard-hook"}]}}]
}
